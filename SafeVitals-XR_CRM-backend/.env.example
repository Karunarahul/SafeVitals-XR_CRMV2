# =====================================================================
# SafeVitals XR CRM Backend Environment Variables
# =====================================================================

# Server Environment
NODE_ENV=production
PORT=10000
HOST=0.0.0.0

# MongoDB Connection String (MongoDB Atlas or standalone cluster)
# For Render / Production: Use your MongoDB Atlas SRV URI
MONGODB_URI=mongodb+srv://karunarahul8885_db_user:<password>@cluster0.iqltbyx.mongodb.net/safevitals?retryWrites=true&w=majority
MONGODB_DB_NAME=safevitals

# JWT Security Configuration (Generate minimum 32 random characters in production)
JWT_SECRET=safevitals-prod-super-secret-key-min-32-chars-hex
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=safevitals-prod-refresh-secret-key-min-32-chars-hex
JWT_REFRESH_EXPIRES_IN=7d

# CORS Allowed Origins (comma-separated if multiple; set to your deployed frontend domain)
CORS_ORIGINS=https://crm.safevitals.com,https://safevitals-crm.onrender.com,http://localhost:3000

# SMTP / Email Configuration (Nodemailer - SendGrid, Mailgun, AWS SES, or Mailtrap)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_smtp_api_key_or_password
SMTP_FROM="SafeVitals XR CRM" <noreply@safevitals.com>
SMTP_STRICT=true

# Persistent File Storage Directory (On Render: /var/data/uploads mounted to Persistent Disk)
UPLOAD_DEST=/var/data/uploads

# Initial Super Admin Seed (Optional - executed only during initial npm run seed:admin)
SEED_ADMIN_EMAIL=admin@safevitals.com
SEED_ADMIN_PASSWORD=AdminPassword123!
SEED_ADMIN_NAME=System Administrator

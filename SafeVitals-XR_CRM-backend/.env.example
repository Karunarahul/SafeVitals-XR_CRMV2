# SafeVitals XR CRM Backend Environment Variables
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/safevitals_crm

# JWT Configuration
JWT_SECRET=safevitals-dev-super-secret-key-change-in-production-min32chars
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=safevitals-dev-refresh-secret-key-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# CORS Allowed Origins (comma-separated if multiple)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# SMTP / Email Configuration (Nodemailer)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM="SafeVitals XR" <noreply@safevitals.com>

# File Uploads Directory
UPLOAD_DEST=./uploads

# Initial Super Admin Seed (Optional - used if database is empty)
SEED_ADMIN_EMAIL=admin@safevitals.com
SEED_ADMIN_PASSWORD=AdminPassword123!
SEED_ADMIN_NAME=System Administrator
